# ============================================================
# Arc WorkNet — Production .gitignore
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz

# ---------- Next.js ----------
.next/
out/
build/
dist/
.vercel

# ---------- TypeScript ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example
wallet.json

# ---------- Package manager logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# ---------- Dev-server logs ----------
dev-server.out.log
dev-server.err.log

# ---------- Testing & Coverage ----------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# ---------- Solidity / Smart Contracts ----------
# Hardhat
artifacts/
cache/
typechain-types/

# Foundry
contracts/out/
contracts/cache/

# ---------- Supabase ----------
supabase/.temp/
supabase/.branches/

# ---------- OS files ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.lnk

# ---------- IDEs & Editors ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---------- AI / Coding Agents ----------
.claude/
.kimchi/
.kilo/
.codex-plugin/
.hallmark/
.zcode/
x.ai/
skills/*
!skills/worknet/
skills-lock.json

# ---------- Misc ----------
*.log
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/

# ---------- Cypress ----------
cypress/screenshots/
cypress/videos/

# ---------- Git worktrees ----------
.worktrees/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
